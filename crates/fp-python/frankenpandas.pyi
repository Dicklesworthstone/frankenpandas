# Interval & IntervalIndex
class Interval:
    left: float
    right: float
    closed: str
    mid: float
    length: float
    is_empty: bool
    def __init__(self, left: float, right: float, closed: str = "right") -> None: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...
    def __contains__(self, item: Any) -> bool: ...
    def __eq__(self, other: Any) -> bool: ...

class IntervalIndex:
    closed: str
    left: Index
    right: Index
    mid: Index
    length: Index
    def __init__(self, data: Any, closed: str = "right", name: Optional[str] = None) -> None: ...
    @staticmethod
    def from_breaks(breaks: Sequence[float], closed: str = "right", name: Optional[str] = None) -> IntervalIndex: ...
    @staticmethod
    def from_tuples(tuples: Sequence[Tuple[float, float]], closed: str = "right", name: Optional[str] = None) -> IntervalIndex: ...
    def __len__(self) -> int: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...

# Categorical
class Categorical:
    categories: Index
    codes: List[int]
    dtype: CategoricalDtype
    ordered: bool
    def __init__(self, values: Any, categories: Optional[Any] = None, ordered: bool = False, dtype: Optional[Any] = None) -> None: ...
    def __len__(self) -> int: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...

# Offsets
class DateOffset:
    n: int
    normalize: bool
    def __init__(self, n: int = 1, normalize: bool = False, **kwargs: Any) -> None: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...
    def __add__(self, other: Any) -> Any: ...
    def __radd__(self, other: Any) -> Any: ...
    def __sub__(self, other: Any) -> Any: ...

class _Offsets:
    DateOffset: type[DateOffset]
    Day: type[DateOffset]
    Hour: type[DateOffset]
    Minute: type[DateOffset]
    Second: type[DateOffset]
    Week: type[DateOffset]
    MonthEnd: type[DateOffset]
    YearEnd: type[DateOffset]

offsets: _Offsets

class _TSeries:
    offsets: _Offsets

tseries: _TSeries

